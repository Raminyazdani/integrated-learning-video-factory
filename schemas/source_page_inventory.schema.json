{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrated_learning_video_factory/schemas/source_page_inventory.schema.json",
  "title": "source_page_inventory",
  "description": "Claude-authored INDEPENDENT enumeration of every meaningful element on every source page, authored BEFORE package planning. It is the ground truth that source_element_coverage_matrix_v2 and source_exhaustive_depth_review are checked against, so coverage is no longer self-reported by a matrix Claude could under-fill. See docs/AUTOMATIC_SOURCE_COVERAGE_AUDIT_LOOP.md and docs/SOURCE_ELEMENT_CRITICALITY_POLICY.md.",
  "type": "object",
  "required": ["source_file", "run_id", "page_count", "pages"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "string" },
    "source_file": { "type": "string" },
    "run_id": { "type": "string" },
    "inventory_version": { "type": "string" },
    "page_count": { "type": "integer", "minimum": 1 },
    "provenance": { "$ref": "#/$defs/provenance" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_page", "elements"],
        "additionalProperties": true,
        "properties": {
          "source_page": { "type": "integer", "minimum": 1 },
          "page_image_path": { "type": "string" },
          "extracted_text_path": { "type": "string" },
          "slide_title": { "type": ["string", "null"] },
          "page_type": { "type": "string", "description": "e.g. content / title / section_divider / agenda / summary / references / blank" },
          "page_note": { "type": "string", "description": "structural explanation if the page has no teachable title/elements" },
          "elements": { "type": "array", "items": { "$ref": "#/$defs/element" } }
        }
      }
    },
    "uncertainty_notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["authored_by"],
      "additionalProperties": true,
      "properties": {
        "authored_by": { "type": "string" },
        "timestamp": { "type": "string" },
        "source_sha256": { "type": "string" }
      }
    },
    "criticality": { "enum": ["critical", "useful", "structural", "decorative", "optional_extension", "uncertain"] },
    "element_type": {
      "enum": ["title", "section_marker", "navigation", "bullet", "paragraph", "formula", "symbol", "table", "figure", "graph", "diagram", "axis", "legend", "label", "arrow", "colored_region", "caption", "note", "warning", "example", "proof_step", "derivation_step", "summary_item", "extra_reading", "footer", "page_number", "logo", "decorative", "uncertain"]
    },
    "element": {
      "type": "object",
      "required": ["element_id", "element_type"],
      "additionalProperties": true,
      "properties": {
        "element_id": { "type": "string" },
        "element_type": { "$ref": "#/$defs/element_type" },
        "source_text_or_visual_description": { "type": "string" },
        "bbox": { "type": "array", "items": { "type": "number" }, "description": "[x0,y0,x1,y1] in page-image px; optional" },
        "region_description": { "type": "string" },
        "visual_description": { "type": "string" },
        "extracted_text_snippet": { "type": "string" },
        "confidence": { "type": ["number", "string"] },
        "uncertainty_note": { "type": "string" },
        "preliminary_criticality": { "$ref": "#/$defs/criticality" },
        "reason": { "type": "string", "description": "required when a teachable element type is marked decorative/structural, or when uncertain" }
      }
    }
  }
}

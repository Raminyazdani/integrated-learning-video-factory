{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrated_learning_video_factory/schemas/company_handoff.schema.json",
  "title": "company_handoff",
  "type": "object",
  "required": ["task_id", "agent_name", "status", "inputs_used", "outputs", "provenance"],
  "additionalProperties": true,
  "properties": {
    "task_id": { "type": "string" },
    "agent_name": { "type": "string" },
    "role_type": { "type": "string" },
    "status": { "enum": ["pending", "running", "pass", "fail", "blocked", "retry"] },
    "inputs_used": { "type": "array", "items": { "type": "string" } },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "uncertainty": { "type": "array", "items": { "type": "string" } },
    "reviewer": { "type": ["string", "null"] },
    "gate_decision": { "type": ["string", "null"] },
    "retries_used": { "type": "integer", "minimum": 0 },
    "provenance": {
      "type": "object",
      "required": ["authored_by"],
      "properties": {
        "authored_by": { "type": "string" },
        "source_sha": { "type": ["string", "null"] },
        "timestamp": { "type": ["string", "null"] }
      }
    }
  }
}

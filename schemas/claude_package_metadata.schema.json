{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrated_learning_video_factory/schemas/claude_package_metadata.schema.json",
  "title": "claude_package_metadata",
  "description": "Claude-authored per-package metadata (source of truth).",
  "type": "object",
  "required": ["run_id", "provenance", "source_pages", "uncertainty_notes", "packages"],
  "additionalProperties": true,
  "properties": {
    "run_id": { "type": "string" },
    "provenance": { "type": "object", "required": ["authored_by"], "properties": { "authored_by": { "enum": ["CLAUDE_CODE_MANUAL_AGENT", "CLAUDE_API"] } } },
    "source_pages": { "type": "array", "items": { "type": "integer" }, "minItems": 1 },
    "uncertainty_notes": { "type": "array", "items": { "type": "string" } },
    "packages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["package_id", "package_title", "teaching_goal_fa", "main_concepts"],
        "additionalProperties": true,
        "properties": {
          "package_id": { "type": "string" },
          "package_title": { "type": "string", "minLength": 1 },
          "teaching_goal_fa": { "type": "string", "minLength": 1 },
          "expected_difficulty": { "type": "string" },
          "main_concepts": { "type": "array", "items": { "type": "string" } },
          "prerequisites": { "type": "array" }
        }
      }
    }
  }
}

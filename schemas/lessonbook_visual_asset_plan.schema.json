{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrated_learning_video_factory/schemas/lessonbook_visual_asset_plan.schema.json",
  "title": "lessonbook_visual_asset_plan",
  "description": "Claude-authored plan of the visuals a chapter needs (full-slide anchors, crops, annotated crops, masked variants, generated teaching diagrams). Drives Python crop/annotation (executor). Per docs/VISUAL_CROP_ANNOTATION_POLICY.md. Every visual must have a pedagogical reason.",
  "type": "object",
  "required": ["schema_version", "run_id", "provenance", "assets"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "string" },
    "run_id": { "type": "string" },
    "package_id": { "type": "string" },
    "provenance": { "type": "object", "required": ["authored_by"], "properties": { "authored_by": { "enum": ["CLAUDE_CODE_MANUAL_AGENT", "CLAUDE_API"] }, "timestamp": { "type": "string" } } },
    "assets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["asset_id", "source_page", "asset_type", "teaching_purpose", "generation_method", "required"],
        "additionalProperties": true,
        "properties": {
          "asset_id": { "type": "string" },
          "source_page": { "type": "integer" },
          "asset_type": { "enum": ["full_slide_anchor", "crop", "annotated_crop", "masked_variant", "generated_teaching_diagram"] },
          "source_region_description": { "type": "string", "description": "what part of the slide this targets (for crop/annotation)" },
          "crop_or_annotation_goal": { "type": "string" },
          "teaching_purpose": { "type": "string", "description": "the pedagogical reason this visual exists" },
          "caption_fa": { "type": "string" },
          "related_element_ids": { "type": "array", "items": { "type": "string" }, "description": "coverage-matrix element_ids this asset supports" },
          "generation_method": { "enum": ["source_crop", "python_annotation", "claude_visual_plan", "generated_diagram"] },
          "crop_box": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4, "description": "[x0,y0,x1,y1] when applicable" },
          "required": { "type": "boolean" }
        }
      }
    }
  }
}

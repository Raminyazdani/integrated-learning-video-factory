{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrated_learning_video_factory/schemas/gemini_tts_text.schema.json",
  "title": "gemini_tts_text",
  "description": "Claude-authored TTS-safe spoken text per slide for Gemini TTS (source of truth).",
  "type": "object",
  "required": ["run_id", "provenance", "source_pages", "uncertainty_notes", "slides"],
  "additionalProperties": true,
  "properties": {
    "run_id": { "type": "string" },
    "provenance": { "type": "object", "required": ["authored_by"], "properties": { "authored_by": { "enum": ["CLAUDE_CODE_MANUAL_AGENT", "CLAUDE_API"] } } },
    "source_pages": { "type": "array", "items": { "type": "integer" }, "minItems": 1 },
    "uncertainty_notes": { "type": "array", "items": { "type": "string" } },
    "slides": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slide_id", "tts_text"],
        "additionalProperties": true,
        "properties": {
          "slide_id": { "type": "string" },
          "tts_text": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrated_learning_video_factory/schemas/company_task_graph.schema.json",
  "title": "company_task_graph",
  "type": "object",
  "required": ["run_id", "generated_at", "tasks"],
  "additionalProperties": true,
  "properties": {
    "run_id": { "type": "string" },
    "generated_at": { "type": "string" },
    "dry_run": { "type": "boolean" },
    "parallel_groups": { "type": "array", "items": { "type": "string" } },
    "join_gates": { "type": "array", "items": { "type": "string" } },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "required": [
        "task_id", "department", "agent_name", "role_type", "specialty",
        "dependencies", "input_artifacts", "output_artifacts", "handoff_path",
        "reviewer_agent", "supervisor_gate", "status", "max_retries", "provenance"
      ],
      "additionalProperties": true,
      "properties": {
        "task_id": { "type": "string" },
        "parent_task_id": { "type": ["string", "null"] },
        "department": { "type": "string" },
        "agent_name": { "type": "string" },
        "role_type": { "enum": ["queen", "lead", "worker", "subworker", "supervisor"] },
        "specialty": { "type": "string" },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "parallel_group_id": { "type": ["string", "null"] },
        "join_gate_id": { "type": ["string", "null"] },
        "input_artifacts": { "type": "array", "items": { "type": "string" } },
        "output_artifacts": { "type": "array", "items": { "type": "string" } },
        "handoff_path": { "type": "string" },
        "reviewer_agent": { "type": ["string", "null"] },
        "supervisor_gate": { "type": ["string", "null"] },
        "status": { "enum": ["pending", "running", "pass", "fail", "blocked", "retry"] },
        "max_retries": { "type": "integer", "minimum": 0 },
        "uncertainty_notes": { "type": "array", "items": { "type": "string" } },
        "provenance": {
          "type": "object",
          "required": ["authored_by"],
          "properties": {
            "authored_by": { "enum": ["claude_code_manual_agent", "claude_api", "openai_fallback", "python_executor", "gemini_tts", "edge_fallback", "coordination", "pending"] },
            "source_sha": { "type": ["string", "null"] },
            "timestamp": { "type": ["string", "null"] }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrated_learning_video_factory/schemas/content_authored.schema.json",
  "title": "content_authored",
  "description": "Claude-authored package content (renderer INPUT, source of truth). Python renders content_json/md from this; never invents it.",
  "type": "object",
  "required": ["package_title", "summary", "learning_goal", "source_pages", "page_explanations", "uncertainty_notes", "provenance"],
  "additionalProperties": true,
  "properties": {
    "package_title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "learning_goal": { "type": "string", "minLength": 1 },
    "source_pages": { "type": "array", "items": { "type": "integer" }, "minItems": 1 },
    "page_explanations": { "type": "array", "minItems": 1 },
    "uncertainty_notes": { "type": "array", "items": { "type": "string" } },
    "provenance": { "type": "object", "required": ["authored_by"], "properties": { "authored_by": { "enum": ["CLAUDE_CODE_MANUAL_AGENT", "CLAUDE_API"] } } }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrated_learning_video_factory/schemas/claude_page_review.schema.json",
  "title": "claude_page_review",
  "description": "Claude-authored page understanding (source of truth). Python may only consume.",
  "type": "object",
  "required": ["run_id", "provenance", "source_pages", "uncertainty_notes", "reviews"],
  "additionalProperties": true,
  "properties": {
    "run_id": { "type": "string" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "source_pages": { "type": "array", "items": { "type": "integer" }, "minItems": 1 },
    "uncertainty_notes": { "type": "array", "items": { "type": "string" } },
    "reviews": { "type": "object", "minProperties": 1 }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["authored_by"],
      "properties": {
        "authored_by": { "enum": ["CLAUDE_CODE_MANUAL_AGENT", "CLAUDE_API"] },
        "timestamp": { "type": ["string", "null"] }
      }
    }
  }
}

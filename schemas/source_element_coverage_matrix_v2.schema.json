{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrated_learning_video_factory/schemas/source_element_coverage_matrix_v2.schema.json",
  "title": "source_element_coverage_matrix_v2",
  "description": "Claude-authored coverage matrix v2. Every source_page_inventory element is mapped to a criticality (by the objective default rule in docs/SOURCE_ELEMENT_CRITICALITY_POLICY.md), a required treatment, required visual support, an owning worker role, a planned/actual lesson location, and a coverage status + auditor verdict. Checked by scripts/validate_coverage_matrix_v2.py AGAINST the inventory (not self-reported).",
  "type": "object",
  "required": ["source_file", "run_id", "inventory_version", "pages"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "string" },
    "source_file": { "type": "string" },
    "run_id": { "type": "string" },
    "inventory_version": { "type": "string" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_page", "elements"],
        "additionalProperties": true,
        "properties": {
          "source_page": { "type": "integer", "minimum": 1 },
          "slide_title": { "type": ["string", "null"] },
          "elements": { "type": "array", "items": { "$ref": "#/$defs/element" } }
        }
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["authored_by"],
      "additionalProperties": true,
      "properties": {
        "authored_by": { "type": "string" },
        "timestamp": { "type": "string" },
        "source_sha256": { "type": "string" }
      }
    },
    "element_type": {
      "enum": ["title", "section_marker", "navigation", "bullet", "paragraph", "formula", "symbol", "table", "figure", "graph", "diagram", "axis", "legend", "label", "arrow", "colored_region", "caption", "note", "warning", "example", "proof_step", "derivation_step", "summary_item", "extra_reading", "footer", "page_number", "logo", "decorative", "uncertain"]
    },
    "element": {
      "type": "object",
      "required": ["element_id", "linked_inventory_element_id", "element_type", "criticality", "required_treatment", "coverage_status"],
      "additionalProperties": true,
      "properties": {
        "element_id": { "type": "string" },
        "linked_inventory_element_id": { "type": "string" },
        "element_type": { "$ref": "#/$defs/element_type" },
        "source_text_or_visual_description": { "type": "string" },
        "criticality": { "enum": ["critical", "useful", "structural", "decorative", "optional_extension", "uncertain"] },
        "required_treatment": { "enum": ["deep_tutor", "formula_deep_mode", "table_reconstruction", "visual_deep_mode", "proof_walkthrough", "brief_context", "optional_extension_brief", "decorative_exclusion", "uncertainty_review"] },
        "required_visual_support": { "enum": ["full_anchor", "crop", "annotated_crop", "masked_variant", "generated_diagram", "none"] },
        "assigned_worker_role": { "type": "string" },
        "planned_lesson_location": { "type": "string" },
        "actual_lesson_location": { "type": "string" },
        "visual_asset_ids": { "type": "array", "items": { "type": "string" } },
        "coverage_status": { "enum": ["not_started", "planned", "taught_deeply", "taught_briefly", "visually_supported", "mentioned_only", "missing", "excluded_with_reason", "uncertain_needs_review"] },
        "auditor_verdict": { "enum": ["pending", "pass", "needs_fix", "uncertain"] },
        "required_fix": { "type": "string" },
        "final_status": { "type": "string" },
        "downgrade_reason": { "type": "string", "description": "REQUIRED when criticality is lower than the element type's default (e.g. a formula/figure/graph/table marked below critical)" },
        "evidence_reference": { "type": "string", "description": "where the teaching actually appears (chapter/beat id, narrative path)" }
      }
    }
  }
}

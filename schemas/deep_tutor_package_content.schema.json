{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrated_learning_video_factory/schemas/deep_tutor_package_content.schema.json",
  "title": "deep_tutor_package_content",
  "description": "Claude-authored DEEP exam-tutor content for one package (v2). Source of truth; Python only renders. Enforces the deep teaching chain from docs/DEEP_PERSIAN_EXAM_TUTOR_VIDEO_POLICY.md.",
  "type": "object",
  "required": ["run_id", "package_id", "provenance", "source_pages", "package_title", "pages", "notation_tracker", "glossary", "exam_tips", "practice_qa", "uncertainty_notes", "confidence"],
  "additionalProperties": true,
  "properties": {
    "run_id": { "type": "string" },
    "package_id": { "type": "string" },
    "provenance": { "type": "object", "required": ["authored_by"], "properties": { "authored_by": { "enum": ["CLAUDE_CODE_MANUAL_AGENT", "CLAUDE_API"] }, "timestamp": { "type": "string" } } },
    "reviewer": { "type": "string" },
    "policy_refs": { "type": "array", "items": { "type": "string" } },
    "terminology_ref": { "type": "string" },
    "source_pages": { "type": "array", "items": { "type": "integer" }, "minItems": 1 },
    "package_title": { "type": "string" },
    "exam_priority": { "enum": ["high", "medium", "low"] },
    "learning_goals": { "type": "array", "items": { "type": "string" } },
    "prerequisites": {
      "type": "array",
      "items": { "type": "object", "required": ["term", "mini_lesson_fa"], "properties": {
        "term": { "type": "string" }, "mini_lesson_fa": { "type": "string" } } }
    },
    "pages": {
      "type": "array", "minItems": 1,
      "description": "One entry per source page: screenshot-anchored teaching unit.",
      "items": {
        "type": "object",
        "required": ["page_id", "page_image_path", "page_type", "exam_priority", "what_this_teaches_fa", "deep_explanation_fa", "source_tag"],
        "additionalProperties": true,
        "properties": {
          "page_id": { "type": "string" },
          "page_image_path": { "type": "string", "description": "run-relative path to the original page screenshot" },
          "page_type": { "enum": ["title", "outline", "bibliography", "definition", "theorem", "proof", "equation", "derivation", "example", "exercise", "solution", "code", "algorithm", "plot", "figure", "table", "summary", "mixed", "other"] },
          "exam_priority": { "enum": ["high", "medium", "low"] },
          "what_this_teaches_fa": { "type": "string", "description": "short framing shown before the deep explanation" },
          "deep_explanation_fa": { "type": "string" },
          "formula_blocks": { "type": "array", "items": { "$ref": "#/$defs/formula_block" } },
          "figure_blocks": { "type": "array", "items": { "type": "object" } },
          "crops": { "type": "array", "items": { "type": "object", "properties": { "crop_box": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 }, "purpose_fa": { "type": "string" } } } },
          "recap_fa": { "type": "string" },
          "source_tag": { "type": "string", "description": "e.g. [منبع: page-06]" }
        }
      }
    },
    "notation_tracker": {
      "type": "array",
      "description": "running symbol table across the package",
      "items": { "$ref": "#/$defs/symbol_row" }
    },
    "glossary": {
      "type": "array",
      "items": { "type": "object", "required": ["term_en", "term_fa", "keep_english", "definition_fa"], "properties": {
        "term_en": { "type": "string" }, "term_fa": { "type": "string" },
        "keep_english": { "type": "boolean" }, "definition_fa": { "type": "string" } } }
    },
    "exam_tips": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["tip_fa", "tag"], "properties": {
        "tip_fa": { "type": "string" },
        "tag": { "enum": ["مفهومی", "محاسباتی", "حفظی", "دام امتحانی"] } } }
    },
    "practice_qa": {
      "type": "object", "required": ["easy", "medium", "challenging"],
      "properties": {
        "easy": { "type": "array", "items": { "$ref": "#/$defs/qa" } },
        "medium": { "type": "array", "items": { "$ref": "#/$defs/qa" } },
        "challenging": { "type": "array", "items": { "$ref": "#/$defs/qa" } }
      }
    },
    "uncertainty_notes": { "type": "array", "items": { "type": "string" } },
    "confidence": {
      "type": "object",
      "required": ["extraction", "translation", "foundation", "math", "glossary", "exam_tips"],
      "properties": {
        "extraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "translation": { "type": "number", "minimum": 0, "maximum": 1 },
        "foundation": { "type": "number", "minimum": 0, "maximum": 1 },
        "math": { "type": "number", "minimum": 0, "maximum": 1 },
        "glossary": { "type": "number", "minimum": 0, "maximum": 1 },
        "exam_tips": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  },
  "$defs": {
    "symbol_row": {
      "type": "object",
      "required": ["symbol", "spoken_form_fa", "meaning_fa", "type"],
      "properties": {
        "symbol": { "type": "string" },
        "spoken_form_fa": { "type": "string" },
        "meaning_fa": { "type": "string" },
        "type": { "enum": ["scalar", "vector", "matrix", "function", "set", "distribution", "density", "probability", "random_variable", "observed_value", "operator", "other"] },
        "shape": { "type": ["string", "null"] },
        "example": { "type": ["string", "null"] },
        "common_confusion_fa": { "type": ["string", "null"] }
      }
    },
    "formula_block": {
      "type": "object",
      "required": ["formula_latex", "purpose_fa", "prerequisite_mini_lesson_fa", "notation_read_aloud_fa", "symbol_table", "numerical_example_fa", "step_by_step", "geometric_intuition_fa", "ml_meaning_fa", "beginner_mistakes", "exam_traps", "final_simple_sentence_fa", "source_tag"],
      "additionalProperties": true,
      "properties": {
        "formula_latex": { "type": "string", "description": "LaTeX math (no plain-text math)" },
        "purpose_fa": { "type": "string" },
        "prerequisite_mini_lesson_fa": { "type": "string" },
        "notation_read_aloud_fa": { "type": "string" },
        "symbol_table": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/symbol_row" } },
        "numerical_example_fa": { "type": "string" },
        "step_by_step": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "geometric_intuition_fa": { "type": "string" },
        "ml_meaning_fa": { "type": "string" },
        "beginner_mistakes": { "type": "array", "items": { "type": "string" } },
        "exam_traps": { "type": "array", "items": { "type": "string" } },
        "final_simple_sentence_fa": { "type": "string" },
        "source_tag": { "type": "string" }
      }
    },
    "qa": {
      "type": "object",
      "required": ["q_fa", "a_fa", "source_tag"],
      "properties": {
        "q_fa": { "type": "string" }, "a_fa": { "type": "string" }, "source_tag": { "type": "string" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrated_learning_video_factory/schemas/lessonbook_chapter_plan.schema.json",
  "title": "lessonbook_chapter_plan",
  "description": "Claude-authored beat sheet for ONE chapter (chapter_NNN <-> package_NNN). Layer-A (structured plan). The ordered teaching beats that the Narrative Tutor Writer turns into woven prose. Enforces progressive structure; NOT shown verbatim in the PDF.",
  "type": "object",
  "required": ["schema_version", "run_id", "chapter_id", "package_id", "provenance", "source_pages", "title_fa", "layer", "opening_intuition_fa", "beats"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "string" },
    "run_id": { "type": "string" },
    "chapter_id": { "type": "string", "pattern": "^chapter_[0-9]+$" },
    "package_id": { "type": "string" },
    "provenance": { "type": "object", "required": ["authored_by"], "properties": { "authored_by": { "enum": ["CLAUDE_CODE_MANUAL_AGENT", "CLAUDE_API"] }, "timestamp": { "type": "string" } } },
    "source_pages": { "type": "array", "minItems": 1, "items": { "type": "integer" } },
    "title_fa": { "type": "string", "minLength": 1 },
    "layer": { "const": "A_structured_plan" },
    "opening_intuition_fa": { "type": "string", "minLength": 1, "description": "the planned simple, symbol-free opening" },
    "why_it_matters_fa": { "type": "string" },
    "prerequisites_recap": {
      "type": "array",
      "items": { "type": "object", "required": ["term", "mini_lesson_fa"], "properties": {
        "term": { "type": "string" }, "mini_lesson_fa": { "type": "string" } } }
    },
    "beats": {
      "type": "array", "minItems": 3,
      "description": "ordered teaching beats; must open with intuition and end with a recap.",
      "items": { "$ref": "#/$defs/beat_plan" },
      "allOf": [
        { "contains": { "type": "object", "required": ["type"], "properties": { "type": { "const": "opening_intuition" } } } },
        { "contains": { "type": "object", "required": ["type"], "properties": { "type": { "const": "recap" } } } }
      ]
    },
    "terms_introduced_here": {
      "type": "array",
      "description": "English terms first introduced in THIS chapter, inline (monotonic; no glossary dump).",
      "items": { "type": "object", "required": ["term_en", "gloss_fa"], "properties": {
        "term_en": { "type": "string" }, "gloss_fa": { "type": "string" }, "first_use": { "const": true } } }
    },
    "formulas_planned": {
      "type": "array",
      "items": { "type": "object", "required": ["formula_latex", "motivation_fa"], "properties": {
        "formula_latex": { "type": "string" }, "motivation_fa": { "type": "string", "description": "WHY we need it — must precede the formula" } } }
    },
    "examples_planned": {
      "type": "array",
      "items": { "type": "object", "required": ["after_concept", "idea_fa"], "properties": {
        "after_concept": { "type": "string" }, "idea_fa": { "type": "string" } } }
    },
    "exam_insights_planned": {
      "type": "array",
      "items": { "type": "object", "required": ["near_concept", "note_fa"], "properties": {
        "near_concept": { "type": "string" }, "note_fa": { "type": "string" } } }
    },
    "practice_planned": {
      "type": "array",
      "items": { "type": "object", "required": ["after_idea", "question_fa"], "properties": {
        "after_idea": { "type": "string" }, "question_fa": { "type": "string" } } }
    },
    "no_glossary_dump": { "const": true },
    "progressive": { "const": true },
    "uncertainty_notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "beat_type": {
      "enum": ["opening_intuition", "why_it_matters", "source_anchor", "guided_explanation", "term_intro", "formula", "example", "geometric_meaning", "exam_insight", "practice", "recap", "transition"]
    },
    "beat_plan": {
      "type": "object",
      "required": ["beat_id", "type", "summary_fa"],
      "additionalProperties": true,
      "properties": {
        "beat_id": { "type": "string" },
        "type": { "$ref": "#/$defs/beat_type" },
        "summary_fa": { "type": "string", "minLength": 1, "description": "what this beat does in the lesson" },
        "attaches_to": { "type": "string", "description": "concept/term/formula this beat is about" },
        "source_anchor": { "type": "object", "properties": {
          "page": { "type": "integer" }, "image_path": { "type": "string" }, "what_to_notice_fa": { "type": "string" } } }
      }
    }
  }
}

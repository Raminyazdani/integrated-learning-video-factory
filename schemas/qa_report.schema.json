{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integrated_learning_video_factory/schemas/qa_report.schema.json",
  "title": "qa_report",
  "description": "Stage 10 QA report (per docs/OUTPUT_ARTIFACT_SPEC.md §3.7). Same shape reusable per-stage QA.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "stage",
    "checks",
    "passed"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "run_id": { "type": "string" },
    "stage": { "type": "integer", "minimum": 0, "maximum": 10 },
    "generated_at": { "type": "string", "format": "date-time" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check_entry" }
    },
    "passed": { "type": "boolean" },
    "issues": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "check_entry": {
      "type": "object",
      "required": ["name", "result"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "result": {
          "type": "string",
          "enum": ["pass", "warn", "fail", "skip"]
        },
        "details": { "type": ["string", "null"] },
        "severity": {
          "type": "string",
          "enum": ["info", "low", "medium", "high", "critical"]
        }
      }
    }
  }
}
